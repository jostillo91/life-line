# Example only. Supply these as server deployment secrets/environment variables; Node does not load this file automatically.
NODE_ENV=production
LIFE_LINE_AI_ALLOWED_ORIGIN=https://your-private-life-line.example
LIFE_LINE_AI_ACCESS_PASSWORD=replace-with-a-long-unique-private-password
OPENAI_API_KEY=replace-with-a-server-side-project-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256
LIFE_LINE_AI_HOST=127.0.0.1
LIFE_LINE_AI_PORT=8787
LIFE_LINE_AI_SESSION_TTL_MINUTES=480
LIFE_LINE_AI_MAX_REQUESTS_PER_MINUTE=6
LIFE_LINE_AI_GLOBAL_REQUESTS_PER_MINUTE=30
LIFE_LINE_AI_MAX_CONCURRENT=2
LIFE_LINE_AI_MAX_BODY_BYTES=10000
LIFE_LINE_AI_MAX_OUTPUT_TOKENS=1100
