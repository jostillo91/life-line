{
  "name": "life-line-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --experimental-strip-types server/index.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build --configLoader runner",
    "build:pages": "tsc -b && tsc -p tsconfig.server.json && vite build --configLoader runner --mode pages",
    "preview:pages": "node tools/preview-pages.mjs",
    "test": "vitest run --configLoader runner",
    "check:pwa": "node tools/inspect-pwa.mjs",
    "audit:deployment": "node --experimental-strip-types tools/deploymentAudit.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@zip.js/zip.js": "^2.16.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.10.0",
    "openai": "^7.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "workbox-window": "^7.4.1"
  }
}
